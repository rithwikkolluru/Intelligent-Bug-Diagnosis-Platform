DATABASE_URL=sqlite:///./bugs.db
MAX_UPLOAD_MB=5
ALLOWED_EXTENSIONS=.txt,.log,.md,.json,.csv
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000
LOG_LEVEL=INFO
# Google Gemini API Key for AI Fix Recommendations & Diagnosis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Multi-provider LLM Configuration (Milestone 2)
# Supported providers: "groq", "gemini", "ollama", "fake", "none" (default: "none" - rule-based fallback)
LLM_PROVIDER=none
LLM_MODEL=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_S=30.0
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_CACHE_DIR=.llm_cache
LLM_CACHE_ENABLED=true
LLM_REQUESTS_PER_MINUTE=30
TRIAGE_USE_RETRIEVAL=false
TRIAGE_TOP_K_NEIGHBOURS=3
MAX_INPUT_CHARS=12000
